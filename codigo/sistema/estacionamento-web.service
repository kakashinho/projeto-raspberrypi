[Unit]
Description=Estacionamento inteligente (servidor e painel web)
After=network.target

[Service]
User=dsm
WorkingDirectory=/home/dsm/codigos/final
# Ajuste o caminho se o node estiver em outro lugar (veja com: which node)
ExecStart=/home/dsm/.local/node/bin/node server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
